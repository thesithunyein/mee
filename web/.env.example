# Only needed for Telegram alerts. The website itself needs no env vars.

# From @BotFather
TELEGRAM_BOT_TOKEN=
# Any long random string. Telegram sends it back on every update.
TELEGRAM_WEBHOOK_SECRET=
# Any long random string. Protects /api/cron/alerts and /api/telegram/setup.
CRON_SECRET=
# Bot username without @. Shows the "Get alerts" button when set.
NEXT_PUBLIC_TELEGRAM_BOT=
# Optional: public channel for a daily summary, e.g. @mee_fire
TELEGRAM_CHANNEL_ID=

# Upstash Redis REST (added automatically by the Vercel Upstash integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=
